# --- Server ---
PORT=4000
# Run "npm run secret" to fill this with a strong random value
JWT_SECRET=
CLIENT_ORIGIN=http://localhost:5173
# Let doctors create their own accounts from the login page (default: only the admin console creates doctors)
ALLOW_SELF_SIGNUP=false
# Set to 1 when running behind nginx / a load balancer so rate limits see the real client IP
# TRUST_PROXY=1
# NODE_ENV=production

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=carenest_hims
